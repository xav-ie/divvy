---
import ChoreForm from "../../../../components/ChoreForm.tsx";
import Skeleton from "../../../../components/Skeleton.astro";
import Layout from "../../../../layouts/Layout.astro";
import { ServiceError } from "../../../../services/errors.ts";
import { getGroup } from "../../../../services/groups.ts";

const { ctx } = Astro.locals;
const param = Astro.params.choreId;
const choreId = param === "new" ? undefined : Number(param);
let group;
try {
  if (choreId !== undefined && !(choreId > 0))
    throw new ServiceError(404, "Not found");
  group = getGroup(ctx, Number(Astro.params.groupId));
  if (!group.chores) throw new ServiceError(404, "Not found");
} catch (err) {
  if (err instanceof ServiceError) return Astro.rewrite("/404");
  throw err;
}
---

<Layout
  title={choreId ? "Edit chore" : "New chore"}
  crumbs={[
    { href: "/groups", label: "Groups" },
    {
      href: `/groups/${group.id}?tab=chores`,
      label: `${group.emoji} ${group.name}`.trim(),
    },
  ]}
  form
>
  <ChoreForm
    client:only="react"
    groupId={group.id}
    choreId={choreId}
    members={group.members.map((m) => ({
      id: m.id,
      name: m.name,
      isYou: m.isYou,
      placeholder: m.placeholder,
    }))}
  >
    <Skeleton slot="fallback" rows={4} />
  </ChoreForm>
</Layout>
